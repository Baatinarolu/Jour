# SANTANDC — Cloud sync config (all optional; local-only works with no env)
# Set AUTH_SECRET to a long random string in production so JWTs survive redeploys
# Example: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional override for where file-driver stores users/journals
# On Vercel the default is /tmp/santandc (ephemeral). For local dev it's server/.data
# SANTANDC_DATA_DIR=/tmp/santandc

# Future: set DATABASE_URL to use Postgres instead of file driver (not yet required)
# DATABASE_URL=postgres://user:pass@host:5432/santandc
