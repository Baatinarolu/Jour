# SANTANDC — cloud sync config. Everything here is optional; the journal is
# local-only and fully usable with no environment variables at all.

# Required for stable sessions in production. Any long random string:
#   openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Durable cloud storage. On Vercel these are injected automatically when you
# attach a KV / Upstash Redis store (Storage → Create Database).
# Either KV_REST_API_* (Vercel KV) or UPSTASH_REDIS_REST_* (Upstash) works.
# KV_REST_API_URL=https://your-store.upstash.io
# KV_REST_API_TOKEN=your-token
# UPSTASH_REDIS_REST_URL=https://your-store.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Without a Redis store the server falls back to files. Locally the default is
# server/.data; on Vercel it is /tmp/santandc, which is wiped on redeploy.
# SANTANDC_DATA_DIR=/tmp/santandc
