# SANTANDC — cloud sync config. Everything here is optional; the journal is
# local-only and fully usable with no environment variables at all.

# Sign-in secret. Optional when a Postgres/Redis store is attached below —
# the server then generates a random secret once and keeps it in the database.
# Set it explicitly (any long random string, e.g. `openssl rand -hex 32`) to
# control rotation yourself; required only with file storage in production.
# AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Durable storage (pick one) ──
# 1) Neon Postgres (recommended) — Vercel → Storage → Create Database → Neon
#    injects DATABASE_URL automatically; there is nothing to copy here. To wire
#    up an existing Neon project by hand, paste its connection string instead
#    (Neon console → Connect; the pooled endpoint is fine — the app queries
#    Neon through its serverless HTTP driver, so no pool tuning is needed):
# DATABASE_URL=postgresql://user:PASSWORD@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
# Any other Postgres (Supabase, self-hosted, local) also works through pg:
# POSTGRES_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Also accepted: POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING.
# If several are set, a Neon URL wins — useful when migrating providers.

# 2) Redis — Vercel KV or Upstash (only if you are not using Postgres).
# KV_REST_API_URL=https://your-store.upstash.io
# KV_REST_API_TOKEN=your-token
# UPSTASH_REDIS_REST_URL=https://your-store.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Without either, the server falls back to files: server/.data locally and
# /tmp/santandc on Vercel (wiped on redeploy — accounts disappear).
# SANTANDC_DATA_DIR=/tmp/santandc

# Optional: relax TLS verification for a self-signed Postgres host.
# PG_SSL_NO_VERIFY=1
